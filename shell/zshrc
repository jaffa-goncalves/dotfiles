
# History Set-Up
HISTFILE=$HOME/.zsh_history
HISTSIZE=5000
SAVEHIST=5000

setopt \
SHARE_HISTORY \
HIST_IGNORE_DUPS \
INC_APPEND_HISTORY \
HIST_IGNORE_SPACE \
APPEND_HISTORY

autoload -Uz compinit
compinit

#Keybindings
bindkey -e


export LANG=en_US.UTF-8

export EDITOR=/opt/homebrew/bin/hx
export VISUAL=/opt/homebrew/bin/hx


# Alias imports
source ~/dotfiles/shell/aliases.sh

# Load function imports
for file in ~/dotfiles/shell/functions/*.sh; do
    source "$file"
done

# Loads Tools
source ~/dotfiles/shell/loaders/tools.sh
